{
  "name": "cases-platform",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx src/server.ts",
    "migrate": "node --env-file-if-exists=.env --import tsx src/migrate.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "seed": "node --env-file-if-exists=.env --import tsx src/seed.ts"
  },
  "dependencies": {
    "@fastify/swagger": "9.9.2",
    "@fastify/swagger-ui": "6.1.2",
    "fastify": "5.6.1",
    "pg": "8.16.3"
  },
  "devDependencies": {
    "@types/node": "22.18.6",
    "@types/pg": "8.15.5",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
